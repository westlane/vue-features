{
  "name": "@westlane/vue-features",
  "version": "0.1.1",
  "description": "Entitled Vue feature mounts — lazy load, custom elements, launch-once lifecycle",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/westlane/vue-features.git"
  },
  "homepage": "https://github.com/westlane/vue-features#readme",
  "bugs": {
    "url": "https://github.com/westlane/vue-features/issues"
  },
  "keywords": [
    "vue",
    "features",
    "entitled",
    "lazy-load",
    "custom-elements",
    "mount",
    "micro-frontend"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "import": "./dist/dev/index.js",
      "default": "./dist/dev/index.js"
    },
    "./lab-vite": {
      "types": "./dist/lab-vite.d.ts",
      "import": "./dist/lab-vite.js",
      "default": "./dist/lab-vite.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check": "yarn lint && yarn typecheck && yarn test && yarn build",
    "demo": "vite --config examples/vue-vite/vite.config.ts",
    "prepublishOnly": "yarn run check",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue": "^5.0.0 || ^6.0.0",
    "vite": "^6.0.0 || ^7.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/compiler-dom": "^3.5.13",
    "@vue/server-renderer": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "happy-dom": "^17.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.13"
  },
  "resolutions": {
    "vite": "^6.3.5"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
